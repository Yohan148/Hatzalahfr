/* =========================================================
   OUTILS
========================================================= */

function getSheet_() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.SHEET);
  if (!sheet) throw new Error("L'onglet Inscriptions est introuvable");
  return sheet;
}

function findRow_(sheet, reference) {
  const last = sheet.getLastRow();
  if (last < 2) return null;
  const values = sheet.getRange(2, 2, last - 1, 1).getValues();
  for (let i = 0; i < values.length; i++) {
    if (String(values[i][0]) === String(reference)) return i + 2;
  }
  return null;
}

function getPerson_(sheet, row) {
  const v = sheet.getRange(row, 1, 1, 23).getValues()[0];
  return {
    reference: v[1],
    formule: v[2],
    prenom: v[3],
    nom: v[4],
    prenom2: v[5],
    nom2: v[6],
    email: v[8],
    adresse: v[9],
    codePostal: v[10],
    ville: v[11],
    transaction: v[16],
    amount: v[17]
  };
}

function nextReceiptNumber_() {
  const props = PropertiesService.getScriptProperties();
  const key = "CERFA_2026";
  let n = Number(props.getProperty(key) || "0");
  n++;
  props.setProperty(key, String(n));
  return CONFIG.RECEIPT_PREFIX + "/" + Utilities.formatString("%05d", n);
}

