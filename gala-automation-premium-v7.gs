/* =========================================================
   ENDPOINT
========================================================= */

function doPost(e) {
  try {
    const p = e.parameter || {};
    const action = p.action || "register";

    if (action === "register") {
      return json_(register_(p));
    }

    if (action === "payment_confirmed") {
      if (p.webhookSecret !== CONFIG.WEBHOOK_SECRET) {
        throw new Error("Webhook non autorisé");
      }

      return json_(paymentConfirmed_(p.reference, p.transactionId, p.amount));
    }

    throw new Error("Action inconnue");

  } catch (err) {
    return json_({
      success: false,
      error: err.message
    });
  }
}

function doGet() {
  return ContentService.createTextOutput("Gala United Hatzalah : système actif");
}


/* =========================================================
   INSCRIPTION
========================================================= */

function register_(p) {
  const sheet = getSheet_();

  const reference =
    p.reference ||
    "GALA26-" + Utilities.getUuid().replace(/-/g, "").substring(0, 8).toUpperCase();

  sheet.appendRow([
    new Date(),                 // 1
    reference,                  // 2
    p.formule || "",            // 3
    p.prenom || "",             // 4
    p.nom || "",                // 5
    p.prenomInvite2 || "",      // 6
    p.nomInvite2 || "",         // 7
    p.telephone || "",          // 8
    p.email || "",              // 9
    p.adresse || "",            // 10
    p.codePostal || "",         // 11
    p.ville || "",              // 12
    p.societe || "",            // 13
    p.message || "",            // 14
    p.consentement || "",       // 15
    "EN ATTENTE",               // 16
    "",                         // 17
    "",                         // 18
    "",                         // 19
    "",                         // 20
    "NON",                      // 21
    "NON",                      // 22
    ""                          // 23
  ]);

  return {
    success: true,
    reference: reference
  };
}


/* =========================================================
   PAIEMENT CONFIRMÉ
========================================================= */

function paymentConfirmed_(reference, transactionId, amount) {

  reference = String(reference || "").trim();
  transactionId = String(transactionId || "").trim();
  amount = Number(String(amount || "0").replace(",", "."));

  if (!reference) throw new Error("Référence manquante");
  if (!transactionId) throw new Error("Transaction manquante");
  if (amount <= 0) throw new Error("Montant incorrect");

  const sheet = getSheet_();
  const row = findRow_(sheet, reference);

  if (!row) {
    throw new Error("Inscription introuvable : " + reference);
  }

  if (String(sheet.getRange(row, 16).getValue()).toUpperCase() === "PAYÉ") {
    return {
      success: true,
      message: "Paiement déjà traité"
    };
  }

  sheet.getRange(row, 16).setValue("PAYÉ");
  sheet.getRange(row, 17).setValue(transactionId);
  sheet.getRange(row, 18).setValue(amount);

  const person = getPerson_(sheet, row);
  const receiptNumber = nextReceiptNumber_();

  sheet.getRange(row, 19).setValue(receiptNumber);
  sheet.getRange(row, 20).setValue(new Date());

  const invitation = createInvitationLandscapeTicket_(person);
  const receipt = createReceiptLikeAllodons_(person, receiptNumber);

  sendPremiumEmail_(person, invitation, receipt);

  sheet.getRange(row, 21).setValue("OUI");
  sheet.getRange(row, 22).setValue("OUI");
  sheet.getRange(row, 23).setValue(new Date());

  return {
    success: true,
    reference: reference,
    receiptNumber: receiptNumber
  };
}


