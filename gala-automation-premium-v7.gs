function blockTitle_(body, label) {
  const p = body.appendParagraph(label);
  p.setBold(true);
  p.setFontSize(10);
  p.setForegroundColor("#111111");
  p.setSpacingAfter(4);
}

function blockField_(body, label, value) {
  let p = body.appendParagraph(label);
  p.setBold(true);
  p.setFontSize(9);
  p.setForegroundColor("#444444");
  p = body.appendParagraph(String(value || ""));
  p.setFontSize(10);
  p.setSpacingAfter(4);
}

function euros_(value) {
  return Number(value || 0).toFixed(2).replace(".", ",") + " Euros";
}

function eurosShort_(value) {
  return Number(value || 0).toFixed(0).replace(".", ",") + " €";
}

function dateFrLong_(date) {
  return Utilities.formatDate(date, "Europe/Paris", "dd MMMM yyyy");
}

function clean_(text) {
  return String(text || "").replace(/[^a-zA-Z0-9À-ÿ_-]/g, "_");
}

function escape_(text) {
  return String(text || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

function json_(value) {
  return ContentService.createTextOutput(JSON.stringify(value))
    .setMimeType(ContentService.MimeType.JSON);
}

function safeAddressLine_(adresse, cp, ville) {
  const a = String(adresse || "").trim();
  const b = String(cp || "").trim();
  const c = String(ville || "").trim();
  return [a, [b, c].join(" ").trim()].filter(Boolean).join(", ");
}

function trimBoth_(a, b) {
  return String((a || "") + " " + (b || "")).trim();
}

function styleText_(shape, size, bold, color, fontFamily) {
  const t = shape.getText().getTextStyle();
  t.setFontSize(size);
  t.setBold(!!bold);
  t.setForegroundColor(color);
  t.setFontFamily(fontFamily || "Arial");
}

function decoCircle_(slide, left, top, diameter, color) {
  const c = slide.insertShape(SlidesApp.ShapeType.ELLIPSE, left, top, diameter, diameter);
  c.getFill().setSolidFill(color);
  c.getBorder().setTransparent();
}

function barcode_(slide, left, top, width, height, color) {
  const gaps = [2,1,2,3,1,2,1,3,2,1,2,2,1,3,1,2,3,1,2,1];
  let x = left;
  for (let i = 0; i < gaps.length; i++) {
    const w = gaps[i];
    const line = slide.insertShape(SlidesApp.ShapeType.RECTANGLE, x, top, w, height);
    line.getFill().setSolidFill(color);
    line.getBorder().setTransparent();
    x += w + 2;
    if (x > left + width) break;
  }
}

/* version simple suffisante pour les montants du Gala */
function numberToFrenchWords_(amount) {
  const n = Math.round(Number(amount || 0));
  const units = [
    "zéro","un","deux","trois","quatre","cinq","six","sept","huit","neuf",
    "dix","onze","douze","treize","quatorze","quinze","seize"
  ];

  function below100(x) {
    if (x < 17) return units[x];
    if (x < 20) return "dix-" + units[x - 10];
    const tens = ["", "", "vingt", "trente", "quarante", "cinquante", "soixante"];
    if (x < 70) {
      const t = Math.floor(x / 10), u = x % 10;
      if (u === 0) return tens[t];
      if (u === 1) return tens[t] + " et un";
      return tens[t] + "-" + units[u];
    }
    if (x < 80) {
      if (x === 71) return "soixante et onze";
      return "soixante-" + below100(x - 60);
    }
    if (x === 80) return "quatre-vingts";
    return "quatre-vingt-" + below100(x - 80);
  }

  function below1000(x) {
    if (x < 100) return below100(x);
    const h = Math.floor(x / 100), rest = x % 100;
    let s = h === 1 ? "cent" : units[h] + " cent";
    if (rest === 0 && h > 1) s += "s";
    if (rest > 0) s += " " + below100(rest);
    return s;
  }

  if (n < 1000) return below1000(n);
  if (n < 1000000) {
    const th = Math.floor(n / 1000), rest = n % 1000;
    let s = th === 1 ? "mille" : below1000(th) + " mille";
    if (rest > 0) s += " " + below1000(rest);
    return s;
  }
  return String(n);
}
